// AI Nexus — Prisma schema
// Default datasource is SQLite for zero-dependency local development.
// To run on PostgreSQL (production path), change `provider` below to
// "postgresql" and point DATABASE_URL at a Postgres instance, then run
// `npx prisma migrate dev`. pgvector-native embedding support is wired
// through the vector-store adapter (see src/rag/vector-store.ts), which
// adds the `vector` column via raw SQL on Postgres.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String
  passwordHash           String
  role                   String                  @default("user")
  settings               String?
  apiKeys                ApiKey[]
  conversations          Conversation[]
  projects               Project[]
  documents              Document[]
  memories               Memory[]
  toolCalls              ToolCall[]
  researchSessions       ResearchSession[]
  reports                Report[]
  auditLogs              AuditLog[]
  apiUsage               ApiUsage[]
  processingJobs         ProcessingJob[]
  documentCollections    DocumentCollection[]
  subjects               Subject[]
  questions              Question[]
  quizSessions           QuizSession[]
  flashcards             Flashcard[]
  flashcardReviews       FlashcardReview[]
  studyProgress          StudyProgress[]
  studyPlans             StudyPlan[]
  studyGoals             StudyGoal[]
  securityScans          SecurityScan[]
  securityTargets        SecurityTarget[]
  securityAuthorizations SecurityAuthorization[]
  securityReports        SecurityReport[]
  securityLabSessions    SecurityLabSession[]
  codingWorkspaces       CodingWorkspace[]
  codingTasks            CodingTask[]
  orchestrationTasks     OrchestrationTask[]
  approvalRequests       ApprovalRequest[]
  approvalAudits         ApprovalAudit[]
  memoryRecords          MemoryRecord[]
  memoryVersions         MemoryVersion[]
  memoryAccessLogs       MemoryAccessLog[]
  memoryConsents         MemoryConsent[]
  memoryRetentionPolicies MemoryRetentionPolicy[]
  memoryScopes           MemoryScope[]
  knowledgeEntities      KnowledgeEntity[]
  knowledgeRelationships KnowledgeRelationship[]
  knowledgeEvidence      KnowledgeEvidence[]
  memoryAgentPermissions MemoryAgentPermission[]
  memoryExports          MemoryExport[]
  memoryConflicts        MemoryConflict[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model Conversation {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String     @default("New Chat")
  agentId   String?
  model     String?
  archived  Boolean    @default(false)
  messages  Message[]
  toolCalls ToolCall[]
  memoryRecords MemoryRecord[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @default("")
  provider       String?
  model          String?
  agent          String?
  status         String       @default("complete")
  error          String?
  attachments    String?
  meta           String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Project {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  conversations    Conversation[]
  documents        Document[]
  memories         Memory[]
  memoryRecords    MemoryRecord[]
  researchSessions ResearchSession[]
  reports          Report[]
  securityScans    SecurityScan[]
  securityTargets  SecurityTarget[]
  orchestrationTasks OrchestrationTask[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
}

model Document {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId             String?
  project               Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  collectionId          String?
  collection            DocumentCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  filename              String
  originalFilename      String?
  mimeType              String?
  sizeBytes             Int?
  status                String              @default("pending")
  error                 String?
  sourceType            String              @default("upload")
  sourceUrl             String?
  extractedText         String?
  meta                  String?
  language              String?
  pageCount             Int?
  chunkCount            Int?
  ocrUsed               Boolean             @default(false)
  ocrLanguage           String?
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  chunks                DocumentChunk[]
  pages                 DocumentPage[]
  processingJobs        ProcessingJob[]
  memoryRecords         MemoryRecord[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, projectId])
  @@index([userId, collectionId])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int
  content    String
  pageNumber Int?
  section    String?
  tokenCount Int?
  embedding  String?
  charStart  Int?
  charEnd    Int?
  createdAt  DateTime @default(now())

  @@unique([documentId, index])
}

model DocumentPage {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber    Int
  text          String
  ocrUsed       Boolean  @default(false)
  ocrConfidence Float?
  ocrLanguage   String?
  createdAt     DateTime @default(now())

  @@unique([documentId, pageNumber])
  @@index([documentId])
}

model ProcessingJob {
  id           String    @id @default(cuid())
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  status       String    @default("queued")
  progress     Int       @default(0)
  currentStage String?
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([documentId])
  @@index([userId])
}

model DocumentCollection {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  documents   Document[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type      String   @default("long_term")
  content   String
  source    String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, projectId])
}

// Seed-metadata for the built-in agent registry (see src/agents/registry.ts).
// Lets admins tune visibility/behaviour per agent without code changes.
model Agent {
  id           String   @id
  name         String
  description  String   @default("")
  capabilities String?
  systemPrompt String   @default("")
  allowedTools String?
  permissions  String?
  enabled      Boolean  @default(true)
  version      String   @default("1")
  updatedAt    DateTime @updatedAt
}

model ToolCall {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  toolName       String
  input          String
  output         String
  success        Boolean       @default(true)
  riskLevel      String        @default("low")
  durationMs     Int?
  error          String?
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}

model ResearchSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  topic       String
  goal        String?
  config      String?
  plan        String?
  status      String    @default("running")
  report      String?
  sources     Source[]
  iterations  String?
  findings    String?
  conflicts   String?
  progress    String?
  cost        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId, projectId])
}

model Source {
  id                String          @id @default(cuid())
  researchSessionId String
  researchSession   ResearchSession @relation(fields: [researchSessionId], references: [id], onDelete: Cascade)
  title             String
  url               String
  provider          String?
  publishedAt       DateTime?
  snippet           String?
  relevance         Float?
  verified          Boolean         @default(false)
  content           String?
  fetchedAt         DateTime        @default(now())

  @@index([researchSessionId])
}

model Report {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversationId String?
  title          String
  format         String   @default("markdown")
  content        String
  meta           String?
  createdAt      DateTime @default(now())

  @@index([userId, projectId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  category  String   @default("auth")
  ip        String?
  userAgent String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([category, createdAt])
}

model ApiUsage {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String?
  model            String?
  kind             String   @default("chat")
  requestId        String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  costUsd          Float?
  durationMs       Int?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  name         String   @default("Default")
  encryptedKey String
  iv           String
  last4        String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider, name])
}

// Education models
model Subject {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  color         String?         @default("#3b82f6")
  topics        Topic[]
  questions     Question[]
  quizSessions  QuizSession[]
  flashcards    Flashcard[]
  studyProgress StudyProgress[]
  studyPlans    StudyPlan[]
  studyGoals    StudyGoal[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
}

model Topic {
  id            String          @id @default(cuid())
  subjectId     String
  subject       Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  parentId      String?
  parent        Topic?          @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Topic[]         @relation("TopicHierarchy")
  questions     Question[]
  quizSessions  QuizSession[]
  flashcards    Flashcard[]
  studyProgress StudyProgress[]
  order         Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([subjectId])
  @@index([parentId])
}

model Question {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId     String?
  subject       Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId       String?
  topic         Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  question      String
  type          String // mcq, true_false, fill_blank, short, long, viva, matching, case_based
  difficulty    String   @default("medium") // easy, medium, hard, university
  options       String? // JSON array for MCQ options
  correctAnswer String?
  explanation   String?
  source        String? // document, general, imported
  sourceDocId   String?
  sourcePage    Int?
  tags          String?
  language      String   @default("en") // en, bn, mixed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quizAnswers QuizAnswer[]

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@index([type])
  @@index([difficulty])
}

model QuizSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId        String?
  topic          Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  name           String
  totalQuestions Int
  currentIndex   Int       @default(0)
  score          Int       @default(0)
  status         String    @default("in_progress") // in_progress, completed, abandoned
  settings       String? // JSON: timeLimit, difficulty, questionTypes, etc.
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  answers QuizAnswer[]

  @@index([userId])
}

model QuizAnswer {
  id            String      @id @default(cuid())
  quizSessionId String
  quizSession   QuizSession @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswer    String
  isCorrect     Boolean
  timeSpent     Int? // milliseconds
  createdAt     DateTime    @default(now())

  @@index([quizSessionId])
  @@index([questionId])
}

model Flashcard {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId  String?
  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId    String?
  topic      Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  front      String
  back       String
  difficulty String   @default("medium")
  tags       String?
  language   String   @default("en")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reviews FlashcardReview[]

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
}

model FlashcardReview {
  id           String    @id @default(cuid())
  flashcardId  String
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating       Int // 1=again, 2=hard, 3=good, 4=easy
  interval     Int // days until next review
  easeFactor   Float     @default(2.5)
  repetitions  Int       @default(0)
  nextReviewAt DateTime  @default(now())
  reviewedAt   DateTime  @default(now())

  @@index([userId])
  @@index([flashcardId])
  @@index([nextReviewAt])
}

model StudyProgress {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId          String?
  subject            Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId            String?
  topic              Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  questionsAttempted Int       @default(0)
  questionsCorrect   Int       @default(0)
  accuracy           Float     @default(0)
  studyMinutes       Int       @default(0)
  flashcardsReviewed Int       @default(0)
  masteryEstimate    Float     @default(0) // 0-1 estimate
  lastStudiedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([userId, subjectId, topicId])
  @@index([userId])
}

model StudyPlan {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name       String
  examDate   DateTime?
  totalHours Float?
  dailyHours Float?
  startDate  DateTime  @default(now())
  endDate    DateTime?
  status     String    @default("active") // active, completed, paused
  planData   String // JSON: daily plans, milestones
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

model StudyGoal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  type        String // daily, weekly, exam, topic
  target      String // JSON: { minutes: 45, questions: 20, etc. }
  current     String    @default("{}") // JSON progress
  periodStart DateTime  @default(now())
  periodEnd   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// Security models
model SecurityScan {
  id           String                  @id @default(cuid())
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  targetType   String // codebase, repository, website, api, document
  targetValue  String // URL, file path, repo URL, etc.
  scanType     String // quick, full, code, dependency, secret, header, tls, owasp
  status       String                  @default("queued") // queued, running, completed, failed, cancelled
  progress     Int                     @default(0)
  targetId     String?
  target       SecurityTarget?         @relation(fields: [targetId], references: [id], onDelete: SetNull)
  findings     SecurityFinding[]
  events       SecurityScanEvent[]
  dependencies SecurityDependency[]
  secrets      SecuritySecretFinding[]
  reports      SecurityReport[]
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([targetId])
}

model SecurityTarget {
  id             String                  @id @default(cuid())
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type           String // website, api, codebase, repository, document
  value          String // URL, file path, repo URL
  name           String?
  description    String?
  authorized     Boolean                 @default(false)
  authorizedAt   DateTime?
  authorizedBy   String?
  scans          SecurityScan[]
  authorizations SecurityAuthorization[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([userId])
  @@index([projectId])
}

model SecurityFinding {
  id            String             @id @default(cuid())
  scanId        String
  scan          SecurityScan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title         String
  category      String // injection, xss, auth, crypto, headers, tls, dependency, secret, owasp
  subCategory   String?
  severity      String // critical, high, medium, low, info
  confidence    String // confirmed, high, medium, low, possible
  description   String
  impact        String?
  evidence      String? // JSON: code snippet, header value, cookie info, etc.
  affectedFile  String?
  affectedLine  Int?
  affectedUrl   String?
  cweId         String?
  owaspCategory String?
  remediation   String?
  references    String? // JSON array of URLs
  status        String             @default("open") // open, fixed, false_positive, accepted_risk, in_progress
  resolvedAt    DateTime?
  evidences     SecurityEvidence[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([scanId])
  @@index([severity])
  @@index([category])
  @@index([status])
}

model SecurityEvidence {
  id        String          @id @default(cuid())
  findingId String
  finding   SecurityFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  type      String // code_snippet, header_value, cookie_info, tls_info, dependency_info
  content   String
  metadata  String? // JSON
  createdAt DateTime        @default(now())

  @@index([findingId])
}

model SecurityAuthorization {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetId     String
  target       SecurityTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  permission   String // owner, admin, read, scan
  authorizedBy String?
  authorizedAt DateTime       @default(now())
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())

  @@unique([userId, targetId])
  @@index([userId])
  @@index([targetId])
}

model SecurityReport {
  id        String       @id @default(cuid())
  scanId    String
  scan      SecurityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  format    String // pdf, docx, markdown, json
  content   String
  metadata  String? // JSON
  createdAt DateTime     @default(now())

  @@index([scanId])
  @@index([userId])
}

model SecurityScanEvent {
  id        String       @id @default(cuid())
  scanId    String
  scan      SecurityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  stage     String // initialized, validating, analyzing, finding, remediating, reporting, completed
  message   String
  progress  Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([scanId])
}

model SecurityDependency {
  id            String       @id @default(cuid())
  scanId        String
  scan          SecurityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name          String
  version       String
  latestVersion String?
  ecosystem     String // npm, pypi, maven, cargo, composer, go, nuget
  vulnerable    Boolean      @default(false)
  advisoryId    String?
  advisoryTitle String?
  severity      String?
  fixedVersion  String?
  createdAt     DateTime     @default(now())

  @@index([scanId])
  @@index([name, version])
}

model SecuritySecretFinding {
  id          String       @id @default(cuid())
  scanId      String
  scan        SecurityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  secretType  String // api_key, token, password, private_key, jwt, cloud_credential
  maskedValue String
  filePath    String?
  lineNumber  Int?
  confidence  String // confirmed, high, medium, low
  entropy     Float?
  createdAt   DateTime     @default(now())

  @@index([scanId])
  @@index([secretType])
}

model SecurityLabSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  labType     String // sqli, xss, auth, authz, headers, csrf, ssrf, config
  status      String    @default("active") // active, completed, failed
  progress    Int       @default(0)
  score       Int?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([labType])
}

// ---------------------------------------------------------------------------
// Phase 6 — AI Software Engineering Agent
// ---------------------------------------------------------------------------

model CodingWorkspace {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  name            String
  description     String             @default("")
  sourceType      String             @default("upload") // repository, upload, local, zip, existing
  rootPath        String? // absolute server-side path for "local"/"existing" sources
  status          String             @default("created") // created, indexing, ready, error
  indexError      String?
  language        String?
  framework       String?
  entryPoints     String? // JSON: string[]
  stats           String? // JSON: file counts, line counts, language breakdown
  ignorePatterns  String? // JSON: string[]
  permissionLevel String             @default("READ_ONLY")
  lastIndexedAt   DateTime?
  files           CodebaseFile[]
  symbols         CodeSymbol[]
  dependencies    CodeDependency[]
  tasks           CodingTask[]
  changes         CodingChange[]
  patches         CodingPatch[]
  testRuns        CodingTestRun[]
  commands        CodingCommand[]
  checkpoints     CodingCheckpoint[]
  snapshots       CodingSnapshot[]
  gitOperations   GitOperation[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
}

model CodebaseFile {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   CodingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  path        String // relative, forward-slash
  language    String          @default("unknown")
  sizeBytes   Int             @default(0)
  hash        String
  lineCount   Int?
  isTest      Boolean         @default(false)
  isConfig    Boolean         @default(false)
  isDoc       Boolean         @default(false)
  content     String? // bounded preview for search/RAG (capped at index time)
  symbolIndex String? // JSON: { name, kind, line, lineEnd, signature }[] (index snapshot)
  imports     String? // JSON: { path, isLocal }[]
  exports     String? // JSON: string[]
  routes      String? // JSON: { method, path }[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  symbols      CodeSymbol[]
  dependencies CodeDependency[]

  @@unique([workspaceId, path])
  @@index([workspaceId, language])
  @@index([workspaceId, isTest])
}

model CodeSymbol {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   CodingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fileId      String
  file        CodebaseFile    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  name        String
  kind        String // function, class, interface, type, variable, const, component, hook, route, endpoint, dbModel, import, export
  lineStart   Int
  lineEnd     Int?
  signature   String?
  language    String          @default("unknown")
  access      String? // public, private, protected, export
  createdAt   DateTime        @default(now())

  @@index([workspaceId, name])
  @@index([workspaceId, kind])
  @@index([fileId])
}

model CodeDependency {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   CodingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fileId      String
  file        CodebaseFile    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  sourcePath  String
  target      String
  isLocal     Boolean         @default(false)
  type        String          @default("import") // import, require, dynamic, config
  line        Int?
  createdAt   DateTime        @default(now())

  @@index([workspaceId, target])
  @@index([fileId])
}

model CodingTask {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   CodingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String          @default("")
  mode        String          @default("understand") // understand, plan, implement, debug, review, refactor, test, document
  status      String          @default("created") // created, planning, awaiting_approval, running, applying, testing, done, failed, cancelled
  plan        String? // JSON: { step, title, detail, files[], tool? , done }[]
  config      String? // JSON: budget limits
  result      String? // JSON: final summary
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  plans       CodingPlan[]
  changes     CodingChange[]
  patches     CodingPatch[]
  testRuns    CodingTestRun[]
  checkpoints CodingCheckpoint[]
  snapshots   CodingSnapshot[]

  @@index([workspaceId])
  @@index([userId])
}

model CodingPlan {
  id            String     @id @default(cuid())
  taskId        String
  task          CodingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspaceId   String
  userId        String
  title         String
  steps         String // JSON: { step, title, detail, files[], tool? }[]
  filesAffected String? // JSON: string[]
  risks         String? // JSON: { level, notes[] }
  cost          String?
  status        String     @default("proposed") // proposed, approved, rejected
  version       Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([taskId])
  @@index([workspaceId])
}

model CodingChange {
  id          String          @id @default(cuid())
  taskId      String?
  task        CodingTask?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   CodingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  filePath    String
  action      String // create, edit, delete, rename
  newPath     String?
  baseHash    String?
  targetHash  String?
  oldContent  String?
  newContent  String?
  diffPreview String? // line diff for UI rendering
  summary     String? // JSON: { additions, deletions }
  status      String          @default("proposed") // proposed, approved, rejected, applied, conflict, rolled_back
  remark      String?
  createdAt   DateTime        @default(now())
  appliedAt   DateTime?
  patches     CodingPatch[]

  @@index([workspaceId])
  @@index([taskId])
}

model CodingPatch {
  id           String          @id @default(cuid())
  changeId     String
  change       CodingChange    @relation(fields: [changeId], references: [id], onDelete: Cascade)
  taskId       String?
  task         CodingTask?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspaceId  String
  workspace    CodingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  title        String
  ops          String // JSON: replacement operations
  status       String          @default("proposed") // proposed, applied, conflict, rolled_back
  appliedAt    DateTime?
  rollbackData String? // JSON: { path: priorContent }
  createdAt    DateTime        @default(now())

  @@index([changeId])
  @@index([workspaceId])
}

model CodingTestRun {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   CodingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  taskId      String?
  task        CodingTask?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  command     String
  status      String          @default("pending") // pending, running, passed, failed
  exitCode    Int?
  stdout      String?
  stderr      String?
  output      String?
  durationMs  Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([workspaceId])
  @@index([taskId])
}

model CodingCommand {
  id            String          @id @default(cuid())
  workspaceId   String
  workspace     CodingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  command       String
  args          String?
  cwd           String?
  riskLevel     String          @default("low")
  permission    String          @default("granted") // granted, needs_confirmation, blocked
  status        String          @default("pending") // pending, running, completed, failed, blocked
  exitCode      Int?
  stdout        String?
  stderr        String?
  durationMs    Int?
  blockedReason String?
  createdAt     DateTime        @default(now())
  finishedAt    DateTime?

  @@index([workspaceId])
}

model CodingCheckpoint {
  id          String          @id @default(cuid())
  taskId      String
  task        CodingTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   CodingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  label       String
  fileHashes  String // JSON: { path: hash }
  status      String          @default("active")
  createdAt   DateTime        @default(now())

  @@index([taskId])
  @@index([workspaceId])
}

model CodingSnapshot {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   CodingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  taskId      String?
  task        CodingTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reason      String
  files       String // JSON: { path: content }
  createdAt   DateTime        @default(now())

  @@index([workspaceId])
}

model GitOperation {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   CodingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  action      String // status, diff, log, branch, commit, checkout, stash, show
  params      String? // JSON
  output      String?
  status      String          @default("completed")
  writeAccess Boolean         @default(false)
  confirmed   Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Phase 7 — Multi-Agent Orchestration
// ---------------------------------------------------------------------------

model OrchestrationTask {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversationId String?
  title          String
  goal           String
  status         String    @default("draft") // draft, planning, ready, running, waiting, waiting_approval, paused, completed, failed, cancelled, blocked
  priority       String    @default("normal") // low, normal, high
  risk           String    @default("read_only") // read_only, low_risk, write, command_execution, external_action, high_risk
  nodeCount      Int       @default(0)
  progress       Int       @default(0) // 0-100
  plan           String? // JSON: TaskPlan (goal, steps, agents, estimatedSteps)
  context        String? // JSON: input context + references
  input          String    @default("")
  budget         String? // JSON: BudgetLimits
  budgetUsage    String? // JSON: BudgetUsage
  result         String? // JSON: FinalReport
  error          String?
  checkpointRef  String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  nodes           OrchestrationNode[]
  nodeDependencies TaskDependency[]
  events          TaskEvent[]
  messages        AgentMessage[]
  approvals       TaskApproval[]
  artifacts       TaskArtifact[]
  checkpoints     TaskCheckpoint[]
  memories        TaskMemory[]
  questions       TaskQuestion[]
  runs            TaskRun[]
  approvalRequests ApprovalRequest[]
  memoryRecords   MemoryRecord[]

  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([projectId])
}

model OrchestrationNode {
  id           String             @id @default(cuid())
  taskId       String
  task         OrchestrationTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parentId     String?
  type         String // research, document_analysis, code_analysis, security_analysis, education, rag, generation, transformation, validation, testing, reporting, tool_execution, user_approval, analysis
  agent        String             @default("general") // general, research, education, security, coding, document, rag, report
  title        String
  description  String             @default("")
  status       String             @default("pending") // pending, ready, running, waiting, waiting_approval, paused, completed, failed, cancelled, retrying, blocked
  priority     Int                @default(5)
  order        Int                @default(0)
  dependencies String? // JSON: string[] of prerequisite node ids (denormalized for scheduling)
  inputs       String? // JSON: node input + artifact refs
  outputs      String? // JSON: structured AgentResult
  artifactRefs String? // JSON: string[] artifact ids
  error        String?
  retries      Int                @default(0)
  maxRetries   Int                @default(2)
  timeoutMs    Int                @default(300000)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  dependsOn   TaskDependency[]  @relation("TaskDependencyTarget")
  blocks      TaskDependency[]  @relation("TaskDependencySource")
  events      TaskEvent[]
  approvals   TaskApproval[]
  questions   TaskQuestion[]
  runs        TaskRun[]
  approvalRequests ApprovalRequest[]

  @@index([taskId, status])
  @@index([parentId])
}

model TaskDependency {
  id         String            @id @default(cuid())
  taskId     String
  task       OrchestrationTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromNodeId String
  fromNode   OrchestrationNode @relation("TaskDependencySource", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  toNode     OrchestrationNode @relation("TaskDependencyTarget", fields: [toNodeId], references: [id], onDelete: Cascade)
  kind       String            @default("data") // data, control, conditional
  createdAt  DateTime          @default(now())

  @@unique([fromNodeId, toNodeId])
  @@index([taskId])
}

model TaskEvent {
  id        String             @id @default(cuid())
  taskId    String
  task      OrchestrationTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  nodeId    String?
  node      OrchestrationNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  type      String
  message   String
  meta      String? // JSON
  createdAt DateTime           @default(now())

  @@index([taskId, createdAt])
  @@index([nodeId])
}

model AgentMessage {
  id            String            @id @default(cuid())
  taskId        String
  task          OrchestrationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  nodeId        String?
  senderAgent   String
  receiverAgent String
  messageType   String // REQUEST, RESPONSE, QUESTION, RESULT, WARNING, ERROR, HANDOFF, VALIDATION, APPROVAL_REQUIRED
  payload       String // JSON
  references    String? // JSON
  priority      Int               @default(5)
  createdAt     DateTime          @default(now())

  @@index([taskId, createdAt])
}

model TaskApproval {
  id          String              @id @default(cuid())
  taskId      String
  task        OrchestrationTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  nodeId      String?
  node        OrchestrationNode?  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  category    String              @default("READ_ONLY") // READ_ONLY, LOW_RISK, WRITE, COMMAND_EXECUTION, EXTERNAL_ACTION, HIGH_RISK
  status      String              @default("pending") // pending, approved, rejected, cancelled
  reason      String              @default("")
  requestedBy String
  askedAt     DateTime            @default(now())
  decidedAt   DateTime?
  decidedBy   String?
  meta        String? // JSON: files, commands, details
  createdAt   DateTime            @default(now())

  @@index([taskId, status])
}

model TaskArtifact {
  id           String             @id @default(cuid())
  taskId       String
  task         OrchestrationTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  nodeId       String?
  creatorAgent String             @default("general")
  artifactType String             @default("note") // report, code_patch, document, research_result, security_finding, dataset, chart, test_result, note
  title        String
  summary      String             @default("")
  body         String? // rendered markdown/text payload
  refId        String? // external reference: report.id, document.id, etc.
  provenance   String? // JSON: { task, agents, sources, version, createdAt }
  createdAt    DateTime           @default(now())

  @@index([taskId, artifactType])
}

model TaskCheckpoint {
  id        String            @id @default(cuid())
  taskId    String
  task      OrchestrationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     String
  data      String // JSON snapshot of node statuses at this point
  createdAt DateTime          @default(now())

  @@index([taskId])
}

model TaskMemory {
  id        String            @id @default(cuid())
  taskId    String
  task      OrchestrationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      String            @default("note") // decision, fact, constraint, note, unresolved
  content   String
  createdAt DateTime          @default(now())

  @@index([taskId])
}

model TaskQuestion {
  id         String             @id @default(cuid())
  taskId     String
  task       OrchestrationTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  nodeId     String?
  node       OrchestrationNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  question   String
  options    String? // JSON: string[]
  status     String             @default("pending") // pending, answered, cancelled
  answer     String?
  askedAt    DateTime           @default(now())
  answeredAt DateTime?
  createdAt  DateTime           @default(now())

  @@index([taskId, status])
}

model TaskRun {
  id               String             @id @default(cuid())
  taskId           String
  task             OrchestrationTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  nodeId           String?
  node             OrchestrationNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  kind             String             @default("agent") // agent, tool, model
  agent            String?
  tool             String?
  provider         String?
  model            String?
  status           String             @default("running") // running, success, failed, cancelled
  ok               Boolean?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  costUsd          Float?
  costEstimated    Boolean            @default(false)
  durationMs       Int?
  error            String?
  meta             String? // JSON
  createdAt        DateTime           @default(now())

  @@index([taskId, kind])
  @@index([nodeId])
}

// ---------------------------------------------------------------------------
// Global Governance — User Approval System (RULE-USER-CONTROL-001 through 004)
// ---------------------------------------------------------------------------

model ApprovalRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId          String?
  task            OrchestrationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  nodeId          String?
  node            OrchestrationNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  agentId         String
  toolId          String?
  actionType      String
  target          String
  description     String
  riskLevel       String
  exactAction     String    // JSON: canonical action representation for hash verification
  approvalHash    String    // SHA256 of canonical action
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED, CANCELLED
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  approvedAt      DateTime?
  rejectedAt      DateTime?
  decidedBy       String?

  @@index([userId, status])
  @@index([taskId, status])
  @@index([agentId, status])
  @@index([expiresAt])
}

model ApprovalAudit {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  approvalId   String?
  actionType   String
  target       String
  riskLevel    String
  event        String   // ACTION_REQUESTED, APPROVAL_REQUIRED, APPROVAL_APPROVED, APPROVAL_REJECTED, ACTION_REVALIDATED, ACTION_EXECUTED, ACTION_BLOCKED, APPROVAL_EXPIRED, APPROVAL_CANCELLED
  status       String
  meta         String?  // JSON: additional context
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([approvalId])
  @@index([event, createdAt])
  @@index([actionType, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 9 — Memory, Long-Term Context Intelligence, Personal Knowledge Graph
// ---------------------------------------------------------------------------

model MemoryRecord {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  taskId          String?
  task            OrchestrationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  documentId      String?
  document        Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  type            String
  scope           String    @default("GLOBAL_USER")
  title           String?
  content         String
  summary         String?
  importance      Float     @default(0.5)
  confidence      Float     @default(0.5)

  sourceType      String
  sourceId        String?
  provenance      String?   // JSON: MemoryProvenance

  embedding       String?   // JSON: vector embedding
  tags            String?   // JSON: string[]
  entities        String?   // JSON: string[]

  privacyLevel    String    @default("NORMAL")
  userVisible     Boolean   @default(true)
  userConfirmed   Boolean   @default(false)
  status          String    @default("ACTIVE")
  version         Int       @default(1)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastAccessedAt  DateTime?
  expiresAt       DateTime?

  versions                MemoryVersion[]
  conflicts               MemoryConflict[] @relation("MemoryConflicts")
  conflictingMemoryConflicts MemoryConflict[] @relation("ConflictingMemoryConflicts")
  tagsRelation            MemoryTag[]
  accessLogs              MemoryAccessLog[]
  consents                MemoryConsent[]
  graphEntities           KnowledgeEntity[] @relation("MemoryEntities")
  exports                 MemoryExport[]
  embeddingRecord         MemoryEmbedding?

  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, scope])
  @@index([userId, projectId])
  @@index([userId, conversationId])
  @@index([userId, taskId])
  @@index([userId, createdAt])
  @@index([userId, importance])
  @@index([userId, expiresAt])
  @@index([sourceType, sourceId])
}

model MemoryVersion {
  id              String       @id @default(cuid())
  memoryId        String
  memory          MemoryRecord @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content         String
  summary         String?
  importance      Float
  confidence      Float
  tags            String?
  entities        String?
  changedBy       String      // "user" | "agent" | "system" | "extraction"
  changeReason    String?
  version         Int
  createdAt       DateTime     @default(now())

  @@index([memoryId, version])
  @@index([userId])
}

model MemoryEmbedding {
  id          String       @id @default(cuid())
  memoryId    String
  memory      MemoryRecord @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  vector      String       // JSON: number[]
  model       String
  dimensions  Int
  createdAt   DateTime     @default(now())

  @@unique([memoryId])
  @@index([memoryId])
}

model MemoryTag {
  id          String       @id @default(cuid())
  memoryId    String
  memory      MemoryRecord @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  tag         String
  createdAt   DateTime     @default(now())

  @@unique([memoryId, tag])
  @@index([tag])
}

model MemorySource {
  id          String   @id @default(cuid())
  sourceType  String
  sourceId    String
  memoryIds   String   // JSON: string[]
  createdAt   DateTime @default(now())

  @@index([sourceType, sourceId])
}

model MemoryConflict {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryId            String
  memory              MemoryRecord   @relation("MemoryConflicts", fields: [memoryId], references: [id], onDelete: Cascade)
  conflictingMemoryId String
  conflictingMemory   MemoryRecord   @relation("ConflictingMemoryConflicts", fields: [conflictingMemoryId], references: [id], onDelete: Cascade)
  conflictType        String         // "CONTRADICTION" | "DUPLICATE" | "OUTDATED" | "SCOPE_MISMATCH"
  description         String
  resolution          String?        // "KEEP_FIRST" | "KEEP_SECOND" | "MERGE" | "USER_DECIDED" | "PENDING"
  resolvedAt          DateTime?
  resolvedBy          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([userId, resolution])
  @@index([memoryId])
  @@index([conflictingMemoryId])
}

model MemoryAccessLog {
  id          String       @id @default(cuid())
  memoryId    String
  memory      MemoryRecord @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId     String?
  operation   String       // "READ" | "SEARCH" | "CREATE" | "UPDATE" | "ARCHIVE" | "DELETE" | "EXPORT" | "SHARE"
  success     Boolean      @default(true)
  meta        String?      // JSON
  ip          String?
  userAgent   String?
  createdAt   DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([memoryId, createdAt])
  @@index([agentId, createdAt])
}

model MemoryConsent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryId    String
  memory      MemoryRecord @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  scope       String   // "GLOBAL" | "PROJECT" | "CONVERSATION" | "AGENT"
  agentId     String?
  granted     Boolean  @default(true)
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@unique([userId, memoryId, scope, agentId])
  @@index([userId, granted])
  @@index([memoryId])
}

model MemoryRetentionPolicy {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // "GLOBAL" | "TYPE" | "SCOPE" | "PROJECT"
  targetValue   String?  // e.g., memory type, scope, projectId
  maxAgeDays    Int?
  maxCount      Int?
  minImportance Float?
  autoArchive   Boolean  @default(false)
  autoDelete    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, type, targetValue])
  @@index([userId])
}

model MemoryScope {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  parentId    String?
  parent      MemoryScope? @relation("ScopeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    MemoryScope[] @relation("ScopeHierarchy")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([parentId])
}

model KnowledgeEntity {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  type            String       // "User" | "Project" | "Technology" | "Skill" | "Document" | "ResearchTopic" | "Subject" | "Course" | "Task" | "Agent" | "Website" | "Organization" | "Concept" | "Preference" | "Goal"
  description     String?
  properties      String?      // JSON
  confidence      Float        @default(0.5)
  importance      Float        @default(0.5)
  sourceType      String
  sourceId        String?
  status          String       @default("ACTIVE")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastAccessedAt  DateTime?

  memories        MemoryRecord[] @relation("MemoryEntities")
  relationships   KnowledgeRelationship[] @relation("EntityRelationships")
  inverseRelationships KnowledgeRelationship[] @relation("InverseEntityRelationships")
  evidence        KnowledgeEvidence[]

  @@index([userId, type])
  @@index([userId, name])
  @@index([userId, status])
  @@index([sourceType, sourceId])
  @@unique([userId, type, name])
}

model KnowledgeRelationship {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEntityId String
  sourceEntity  KnowledgeEntity  @relation("EntityRelationships", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntityId String
  targetEntity  KnowledgeEntity  @relation("InverseEntityRelationships", fields: [targetEntityId], references: [id], onDelete: Cascade)
  type          String           // "PREFERS" | "USES" | "WORKS_ON" | "STUDIES" | "READS" | "RELATED_TO" | "DEPENDS_ON" | "COMPLETED" | "INTERESTED_IN" | "CREATED" | "REFERENCES" | "HAS_GOAL" | "HAS_TASK"
  confidence    Float            @default(0.5)
  weight        Float            @default(1.0)
  properties    String?          // JSON
  evidence      KnowledgeEvidence[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@unique([sourceEntityId, targetEntityId, type])
}

model KnowledgeEvidence {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId      String?
  entity        KnowledgeEntity?     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  relationshipId String?
  relationship  KnowledgeRelationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  sourceType    String               // "conversation" | "document" | "research" | "task" | "user_explicit"
  sourceId      String
  excerpt       String?
  confidence    Float                @default(0.5)
  createdAt     DateTime             @default(now())

  @@index([userId])
  @@index([entityId])
  @@index([relationshipId])
  @@index([sourceType, sourceId])
}

model MemoryAgentPermission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId     String
  permission  String   // "READ" | "SEARCH" | "CREATE" | "UPDATE" | "ARCHIVE" | "DELETE" | "EXPORT" | "SHARE"
  scope       String   // "GLOBAL" | "PROJECT" | "CONVERSATION" | "TASK" | "DOCUMENT_COLLECTION" | "AGENT" | "SESSION"
  scopeId     String?
  granted     Boolean  @default(true)
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@unique([userId, agentId, permission, scope, scopeId])
  @@index([userId, agentId])
  @@index([agentId, scope])
}

model MemoryExport {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryId    String
  memory      MemoryRecord @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  format      String       // "JSON" | "CSV" | "MARKDOWN"
  content     String
  createdAt   DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([memoryId])
}
